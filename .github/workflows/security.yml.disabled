name: Automated Security Checks & Tests

on:
  push:
    branches: [ main, master ]
  pull_request:
    branches: [ main, master ]

jobs:
  security-audit:
    name: Security & Quality Audit
    runs-on: ubuntu-latest

    steps:
      - name: Checkout Code
        uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: 20
          cache: 'npm'

      # 1. Scan Kredensial / Secret yang Bocor
      - name: Run Gitleaks (Secret Scan)
        uses: gitleaks/gitleaks-action@v2
        continue-on-error: true
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}

      # 2. Install Dependencies
      - name: Install Dependencies
        run: npm ci --legacy-peer-deps

      # 3. Dependency Vulnerability Audit
      - name: Run Dependency Audit
        run: npm audit --audit-level=high
        continue-on-error: true

      # 4. Linter & Typecheck
      - name: Run Lint
        run: npm run lint

      # 5. Endpoint Security Scanner
      - name: Run API Endpoint Security Scanner
        run: npx tsx scripts/scan-api-security.ts

      # 6. Automated Security & RBAC Tests
      - name: Run Vitest Security Tests
        run: npm run test:security
