# ==============================================================================
# KONFIGURASI BASIS DATA (MySQL 8+)
# ==============================================================================
DATABASE_URL="mysql://root:password@127.0.0.1:3306/wargaku"

# ==============================================================================
# KONFIGURASI AUTENTIKASI (Better Auth)
# ==============================================================================
# Generate secret key acak (misal via terminal: openssl rand -base64 32)
BETTER_AUTH_SECRET="your_random_generated_secret_key_here"
BETTER_AUTH_URL="http://localhost:3000"

# ==============================================================================
# KONFIGURASI APLIKASI
# ==============================================================================
NEXT_PUBLIC_APP_URL="http://localhost:3000"
DEFAULT_PASSWORD="wargaku123"

# ==============================================================================
# LAYANAN EMAIL TRANSAKSIONAL (Brevo)
# Digunakan untuk email aktivasi akun baru dan pengiriman token reset password
# ==============================================================================
BREVO_API_KEY="xkeysib-your_brevo_api_key"
BREVO_SENDER_EMAIL="admin@wargaku.local"

# ==============================================================================
# MEDIA CLOUD STORAGE (Cloudinary)
# Digunakan untuk upload foto nota kuitansi kas, foto profil, dan scan berkas KK/KTP
# ==============================================================================
CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"

# ==============================================================================
# ANTI-BOT & CAPTCHA (Cloudflare Turnstile)
# Digunakan untuk validasi keamanan pada formulir laporan pengaduan publik
# ==============================================================================
NEXT_PUBLIC_TURNSTILE_SITE_KEY="your_turnstile_site_key"
TURNSTILE_SECRET_KEY="your_turnstile_secret_key"

# ==============================================================================
# WEB PUSH NOTIFICATIONS (OneSignal - Opsional)
# ==============================================================================
NEXT_PUBLIC_ONESIGNAL_APP_ID="your_onesignal_app_id"

# ==============================================================================
# GOOGLE DRIVE PICKER (Opsional)
# ==============================================================================
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""
NEXT_PUBLIC_GOOGLE_API_KEY=""
